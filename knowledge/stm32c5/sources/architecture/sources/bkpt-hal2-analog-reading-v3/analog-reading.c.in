#include "{{unit}}.h"
/* Units on the same converter share one handle and its state. Each unit
 * carries these definitions as weak ones, so the program holds exactly one of
 * each whatever the number of units. */
__attribute__((weak)) hal_adc_handle_t bkpt_shared_{{converter_name}}_handle;
/* 0 not attempted, 1 active and calibrated, 2 failed. */
__attribute__((weak)) unsigned int bkpt_shared_{{converter_name}}_state;
static unsigned int attempted;
static hal_status_t status = HAL_ERROR;
static ADC_TypeDef *registers(void)
{
  return (ADC_TypeDef *)((uint32_t){{converter_instance}});
}
/* Whether the first rank of the regular sequence holds this unit's input,
 * read from the converter itself and not from a copy a unit keeps. */
static int holds_this_input(void)
{
  return LL_ADC_CHANNEL_TO_DECIMAL_NB(LL_ADC_REG_GetSequencerRanks(registers(), LL_ADC_REG_RANK_1)) ==
         LL_ADC_CHANNEL_TO_DECIMAL_NB((uint32_t){{channel}});
}
static hal_status_t select_input(void)
{
  hal_adc_handle_t *converter = &bkpt_shared_{{converter_name}}_handle;
  hal_adc_channel_config_t input = {0};
  input.group = HAL_ADC_GROUP_REGULAR;
  input.sequencer_rank = 1U;
  input.sampling_time = HAL_ADC_SAMPLING_TIME_289CYCLES;
  input.input_mode = HAL_ADC_IN_SINGLE_ENDED;
  hal_status_t result = HAL_ADC_SetConfigChannel(converter, {{channel}}, &input);
  if (result != HAL_OK) { return result; }
  result = HAL_ADC_Start(converter);
  if (result != HAL_OK) { return result; }
  return HAL_ADC_Calibrate(converter);
}
static hal_status_t bring_up(void)
{
  hal_adc_handle_t *converter = &bkpt_shared_{{converter_name}}_handle;
  /* The SDK sets the ADC and DAC kernel clock only while the converter's bus
   * clock is off, so the kernel clock comes before that clock is enabled.
   * With the bus clock already on the call is refused; the clock in force
   * must then already be the one this unit needs. Reading the configuration
   * back decides both cases. */
  (void)HAL_RCC_ADCDAC_SetConfigKernelClk(HAL_RCC_ADCDAC_CLK_SRC_HCLK, HAL_RCC_ADCDAC_PRESCALER8);
  hal_rcc_adcdac_clk_src_t source = HAL_RCC_ADCDAC_CLK_SRC_HCLK;
  hal_rcc_adcdac_prescaler_t divider = HAL_RCC_ADCDAC_PRESCALER1;
  HAL_RCC_ADCDAC_GetConfigKernelClk(&source, &divider);
  if (source != HAL_RCC_ADCDAC_CLK_SRC_HCLK || divider != HAL_RCC_ADCDAC_PRESCALER8 ||
      HAL_RCC_ADCDAC_GetKernelClkFreq() != 18000000U) { return HAL_ERROR; }
  {{converter_clock}}();
  if (LL_ADC_IsEnabled(registers()) != 0U) { return HAL_BUSY; }
  hal_status_t result = HAL_ADC_Init(converter, {{converter_instance}});
  if (result != HAL_OK) { return result; }
  hal_adc_config_t config = {0};
  config.resolution = HAL_ADC_RESOLUTION_12_BIT;
  config.sampling_mode = HAL_ADC_SAMPLING_MODE_NORMAL;
  result = HAL_ADC_SetConfig(converter, &config);
  if (result != HAL_OK) { return result; }
  hal_adc_reg_config_t regular = {0};
  regular.trigger_src = HAL_ADC_REG_TRIG_SOFTWARE;
  regular.trigger_edge = HAL_ADC_REG_TRIG_EDGE_NONE;
  regular.sequencer_length = 1U;
  regular.sequencer_discont = HAL_ADC_REG_SEQ_DISCONT_DISABLE;
  regular.continuous = HAL_ADC_REG_CONV_SINGLE;
  regular.overrun = HAL_ADC_REG_OVR_DATA_OVERWRITTEN;
  result = HAL_ADC_REG_SetConfig(converter, &regular);
  if (result != HAL_OK) { return result; }
  return select_input();
}
hal_status_t {{unit}}_init(void)
{
  if (attempted != 0U) { return status; }
  attempted = 1U;
  if (bkpt_shared_{{converter_name}}_state == 0U) {
    bkpt_shared_{{converter_name}}_state = 2U;
    status = bring_up();
    if (status != HAL_OK) { return status; }
    bkpt_shared_{{converter_name}}_state = 1U;
  } else if (bkpt_shared_{{converter_name}}_state != 1U) {
    return status;
  }
  {{pad_clock}}();
  hal_gpio_config_t gpio = {0};
  gpio.mode = HAL_GPIO_MODE_ANALOG;
  gpio.pull = HAL_GPIO_PULL_NO;
  status = HAL_GPIO_Init({{pad_port}}, {{pad_pin}}, &gpio);
  return status;
}
hal_status_t {{unit}}_read(uint32_t *counts)
{
  hal_adc_handle_t *converter = &bkpt_shared_{{converter_name}}_handle;
  if (attempted == 0U || status != HAL_OK || bkpt_shared_{{converter_name}}_state != 1U) { return HAL_ERROR; }
  if (counts == NULL) { return HAL_INVALID_PARAM; }
  if (__get_IPSR() != 0U) { return HAL_BUSY; }
  if (HAL_ADC_GetState(converter) != HAL_ADC_STATE_ACTIVE ||
      HAL_ADC_GetStateGroup(converter, HAL_ADC_GROUP_REGULAR) != HAL_ADC_GROUP_STATE_IDLE) { return HAL_BUSY; }
  /* The handle says active and idle; the converter itself must agree. If it
   * was stopped, or converts, behind the units, nothing they know holds. */
  if (LL_ADC_IsEnabled(registers()) == 0U || LL_ADC_REG_IsConversionOngoing(registers()) != 0U) {
    bkpt_shared_{{converter_name}}_state = 2U;
    return HAL_ERROR;
  }
  hal_status_t result;
  if (!holds_this_input()) {
    /* The SDK configures a channel only while the converter is stopped. */
    result = HAL_ADC_Stop(converter);
    if (result == HAL_OK) { result = select_input(); }
    if (result != HAL_OK || !holds_this_input()) { bkpt_shared_{{converter_name}}_state = 2U; return HAL_ERROR; }
  }
  result = HAL_ADC_REG_StartConv(converter);
  if (result != HAL_OK) { return result; }
  result = HAL_ADC_REG_PollForConv(converter, 2U);
  if (result != HAL_OK) {
    if (HAL_ADC_REG_StopConv(converter) != HAL_OK) { bkpt_shared_{{converter_name}}_state = 2U; }
    return result;
  }
  const uint32_t data = (uint32_t)HAL_ADC_REG_ReadConversionData(converter);
  /* One conversion per start: the group must be idle again for the next read. */
  if (HAL_ADC_GetStateGroup(converter, HAL_ADC_GROUP_REGULAR) != HAL_ADC_GROUP_STATE_IDLE &&
      HAL_ADC_REG_StopConv(converter) != HAL_OK) { bkpt_shared_{{converter_name}}_state = 2U; return HAL_ERROR; }
  *counts = data;
  return HAL_OK;
}
