{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BKPT debug integration profiles",
  "description": "Schema for the additive debug_profiles property in trace-support.json. Describes topology identity only; does not authorize hardware accesses or configure CTI.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profiles"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "match",
          "cores"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 95
          },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rom"
            ],
            "properties": {
              "rom": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ap",
                  "designer",
                  "part"
                ],
                "properties": {
                  "ap": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 7
                  },
                  "designer": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 2047
                      },
                      {
                        "type": "string",
                        "pattern": "^0x(?:[0-7][0-9a-fA-F]{2}|[0-9a-fA-F]{1,2})$"
                      }
                    ]
                  },
                  "part": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4095
                      },
                      {
                        "type": "string",
                        "pattern": "^0x[0-9a-fA-F]{1,3}$"
                      }
                    ]
                  }
                }
              }
            }
          },
          "cores": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "ap",
                "scs_base",
                "cpuid_part"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 63
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 63
                },
                "ap": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 7
                },
                "scs_base": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294963200,
                      "multipleOf": 4096
                    },
                    {
                      "type": "string",
                      "pattern": "^0x[0-9a-fA-F]{5}000$"
                    }
                  ]
                },
                "cpuid_part": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4095
                    },
                    {
                      "type": "string",
                      "pattern": "^0x[0-9a-fA-F]{1,3}$"
                    }
                  ]
                }
              }
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "comment": {
            "type": "string"
          }
        }
      }
    }
  }
}
