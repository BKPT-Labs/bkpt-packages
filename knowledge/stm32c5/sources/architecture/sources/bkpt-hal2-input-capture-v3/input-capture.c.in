#include "{{unit}}.h"
static unsigned int attempted;
static hal_status_t status = HAL_ERROR;
static hal_tim_handle_t timer;
/* 144 MHz divided by 144: one count is one microsecond. */
static const uint32_t prescaler = 143U;
static const uint32_t period = 65535U;
/* The other of the timer's first two channels. Left as the timer reset
 * leaves it, an output compare that drives no pad, its flag is set whenever
 * the counter passes the compare value: a mark at half a turn. */
#define BKPT_HALF_CHANNEL (({{channel_number}}U == 1U) ? 2U : 1U)
#define BKPT_HALF_COUNT 0x8000U
/* Status bits of a channel: capture and compare flags are bits 1..4 and
 * overcapture flags bits 9..12, in channel order. */
static const uint32_t captured = TIM_SR_CC1IF << ({{channel_number}}U - 1U);
static const uint32_t overcaptured = TIM_SR_CC1OF << ({{channel_number}}U - 1U);
static const uint32_t half_turn = TIM_SR_CC1IF << (BKPT_HALF_CHANNEL - 1U);
static volatile uint32_t *half_compare(void)
{
  /* The four compare registers follow one another in the register block. */
  return &(&{{peripheral_symbol}}->CCR1)[BKPT_HALF_CHANNEL - 1U];
}
static int clock_and_registers_match(void)
{
  return HAL_RCC_TIM_GetKernelClkFreq({{peripheral_symbol}}) == 144000000U &&
         LL_TIM_GetPrescaler({{peripheral_symbol}}) == prescaler &&
         LL_TIM_GetAutoReload({{peripheral_symbol}}) == period &&
         *half_compare() == BKPT_HALF_COUNT;
}
hal_status_t {{unit}}_init(void)
{
  if (attempted != 0U) { return status; }
  attempted = 1U;
  if (HAL_RCC_TIM_GetKernelClkFreq({{peripheral_symbol}}) != 144000000U) { return status; }
  {{timer_clock}}();
  if (LL_TIM_IsEnabledCounter({{peripheral_symbol}}) != 0U) { status = HAL_BUSY; return status; }
  {{timer_reset}}();
  status = HAL_TIM_Init(&timer, {{timer_instance}});
  if (status != HAL_OK) { return status; }
  hal_tim_config_t config = {0};
  config.prescaler = prescaler;
  config.period = period;
  config.repetition_counter = 0U;
  config.counter_mode = HAL_TIM_COUNTER_UP;
  config.clock_sel.clock_source = HAL_TIM_CLK_INTERNAL;
  status = HAL_TIM_SetConfig(&timer, &config);
  if (status != HAL_OK) { return status; }
  hal_tim_ic_channel_config_t input = {0};
  input.source = {{input_source}};
  input.polarity = HAL_TIM_IC_RISING_FALLING;
  input.filter = HAL_TIM_FDIV1;
  status = HAL_TIM_IC_SetConfigChannel(&timer, {{channel}}, &input);
  if (status != HAL_OK) { return status; }
  hal_tim_ic_capture_unit_config_t unit = {0};
  unit.source = HAL_TIM_IC_DIRECT;
  unit.prescaler = HAL_TIM_IC_DIV1;
  status = HAL_TIM_IC_SetConfigCaptureUnit(&timer, {{capture_unit}}, &unit);
  if (status != HAL_OK) { return status; }
  *half_compare() = BKPT_HALF_COUNT;
  if (!clock_and_registers_match()) { status = HAL_ERROR; return status; }
  {{pad_clock}}();
  hal_gpio_config_t gpio = {0};
  gpio.mode = HAL_GPIO_MODE_ALTERNATE;
  gpio.output_type = HAL_GPIO_OUTPUT_PUSHPULL;
  gpio.pull = {{pull_symbol}};
  gpio.speed = HAL_GPIO_SPEED_FREQ_LOW;
  gpio.alternate = {{pad_alternate}};
  status = HAL_GPIO_Init({{pad_port}}, {{pad_pin}}, &gpio);
  return status;
}
/* One look at the timer, taken as one step. With interrupts masked it reads
 * the count and then the status, acknowledges the marks that status showed,
 * and reads the marks again. The mask the caller had is put back.
 *
 * Each turn of the counter sets two marks, the overflow and the half-turn
 * compare, 32768 counts apart, and a mark stays set until it is acknowledged.
 * Writing 0 clears a flag and writing 1 leaves it, so only the marks seen
 * are cleared and a mark set after the status was read is kept for the next
 * look. *later is what is set behind the acknowledgement. */
static void look(uint32_t *count, uint32_t *flags, uint32_t *later)
{
  const uint32_t both = TIM_SR_UIF | half_turn;
  const uint32_t masked = __get_PRIMASK();
  __disable_irq();
  *count = {{peripheral_symbol}}->CNT & 0xFFFFU;
  *flags = {{peripheral_symbol}}->SR;
  if ((*flags & both) != 0U) { {{peripheral_symbol}}->SR = ~(*flags & both); }
  *later = {{peripheral_symbol}}->SR & both;
  __set_PRIMASK(masked);
}
/* Waits for the next captured edge. *turns counts the wraps of the 16-bit
 * counter since the measurement began; *at is the time of the edge in counts
 * since then and *level the pad level right after it.
 *
 * What the marks tell. From one status read to the next, a whole turn or
 * more sets both marks. So with at most one mark seen, less than a turn has
 * passed, the overflow seen alone is exactly one wrap, and no half-turn
 * compare lies between the two reads: everything before that wrap happened
 * at a count of 0x8000 or above and everything after it below 0x8000. That
 * places a capture, and the count read just before the status, on the right
 * side of the wrap by its value alone, wherever the caller was delayed.
 *
 * What ends the measurement. Both marks seen at once: the number of turns is
 * not known. A mark set behind the acknowledgement of the other, or both set
 * behind a look that saw none: either half a turn or more passed inside the
 * look, which masking excludes unless the processor was stopped there, and
 * an acknowledged mark may then have been set twice; or the look came half
 * a turn after the mark it acknowledged, at the instant the other was set.
 * The unit cannot tell the two apart. The second needs 32767 counts or more
 * between two looks. The overcapture flag, or a further edge while one is
 * read: an edge was lost or the level read no longer belongs to the edge. */
static hal_status_t next_edge(uint32_t *turns, uint32_t limit, uint32_t *at, uint32_t *level)
{
  const uint32_t both = TIM_SR_UIF | half_turn;
  for (;;) {
    uint32_t count = 0U;
    uint32_t flags = 0U;
    uint32_t later = 0U;
    look(&count, &flags, &later);
    const uint32_t marks = flags & both;
    if (marks == both || later == both || (marks != 0U && later != 0U)) { return HAL_ERROR; }
    if ((flags & overcaptured) != 0U) { return HAL_ERROR; }
    const uint32_t wrapped = ((marks & TIM_SR_UIF) != 0U) ? 1U : 0U;
    *turns += wrapped;
    if ((flags & captured) != 0U) {
      /* Reading the capture register clears the capture flag. */
      const uint32_t value = HAL_TIM_IC_ReadChannelCapturedValue(&timer, {{channel}}) & 0xFFFFU;
      const uint32_t high = (HAL_GPIO_ReadPin({{pad_port}}, {{pad_pin}}) == HAL_GPIO_PIN_SET) ? 1U : 0U;
      const uint32_t after = {{peripheral_symbol}}->SR;
      /* An edge that arrived meanwhile replaced the value or makes the level read above ambiguous. */
      if ((after & (captured | overcaptured)) != 0U) { return HAL_ERROR; }
      const uint32_t turn = (wrapped != 0U && value >= BKPT_HALF_COUNT) ? (*turns - 1U) : *turns;
      const uint32_t stamp = (turn << 16) | value;
      /* An edge at or after the time limit is not part of the measurement. */
      if (stamp >= limit) { return HAL_TIMEOUT; }
      *at = stamp;
      *level = high;
      return HAL_OK;
    }
    /* No edge was waiting when the status was read, and the count was read
     * before it: every edge still to come is at or after this count. */
    const uint32_t turn = (wrapped != 0U && count >= BKPT_HALF_COUNT) ? (*turns - 1U) : *turns;
    if (((turn << 16) | count) >= limit) { return HAL_TIMEOUT; }
  }
}
hal_status_t {{unit}}_measure(uint32_t timeout_ms, uint32_t *period_us, uint32_t *high_us)
{
  if (attempted == 0U || status != HAL_OK) { return HAL_ERROR; }
  if (period_us == NULL || high_us == NULL || timeout_ms == 0U || timeout_ms > 60000U) { return HAL_INVALID_PARAM; }
  if (__get_IPSR() != 0U || HAL_TIM_GetState(&timer) != HAL_TIM_STATE_IDLE ||
      LL_TIM_IsEnabledCounter({{peripheral_symbol}}) != 0U) { return HAL_BUSY; }
  if (!clock_and_registers_match()) { return HAL_ERROR; }
  /* The time limit in counts of the timer clock, one per microsecond. */
  const uint32_t limit = timeout_ms * 1000U;
  LL_TIM_GenerateEvent_UPDATE({{peripheral_symbol}});
  {{peripheral_symbol}}->SR = 0U;
  hal_status_t result = HAL_TIM_Start(&timer);
  if (result != HAL_OK) { status = HAL_ERROR; return result; }
  result = HAL_TIM_IC_StartChannel(&timer, {{channel}});
  if (result != HAL_OK) { (void)HAL_TIM_Stop(&timer); status = HAL_ERROR; return result; }
  uint32_t turns = 0U;
  uint32_t at = 0U;
  uint32_t level = 0U;
  uint32_t rise = 0U;
  uint32_t fall = 0U;
  uint32_t next = 0U;
  /* 0 waits for a rising edge, 1 for the falling edge, 2 for the rising edge that ends the period. */
  unsigned int step = 0U;
  while (result == HAL_OK && step < 3U) {
    result = next_edge(&turns, limit, &at, &level);
    if (result != HAL_OK) { break; }
    if (step == 0U) {
      if (level != 0U) { rise = at; step = 1U; }
    } else if (step == 1U) {
      if (level != 0U) { result = HAL_ERROR; } else { fall = at; step = 2U; }
    } else {
      if (level == 0U) { result = HAL_ERROR; } else { next = at; step = 3U; }
    }
  }
  hal_status_t stopped = HAL_TIM_IC_StopChannel(&timer, {{channel}});
  if (stopped == HAL_OK) { stopped = HAL_TIM_Stop(&timer); }
  if (stopped != HAL_OK || LL_TIM_IsEnabledCounter({{peripheral_symbol}}) != 0U) { status = HAL_ERROR; return HAL_ERROR; }
  if (result != HAL_OK) { return result; }
  *period_us = next - rise;
  *high_us = fall - rise;
  return HAL_OK;
}
