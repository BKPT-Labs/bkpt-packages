  "recipes": [
    {
      "id": "hal2-led-uart",
      "description": "50 ms LED pulse and UART counter; period includes output time. Requires board default USART wiring.",
      "backend": "mx2",
      "families": [
        "STM32C5"
      ],
      "hal": "HAL2",
      "sdk": "stm32-hal2-2.1.0",
      "parameters": {
        "period_ms": {
          "default": 1000,
          "min": 100,
          "max": 10000
        }
      },
      "requires": [
        {
          "pin": "{{led_pin}}",
          "signal": "GPIO"
        },
        {
          "pin": "{{tx_pin}}",
          "signal": "{{uart}}_TX"
        },
        {
          "pin": "{{rx_pin}}",
          "signal": "{{uart}}_RX"
        }
      ],
      "steps": [
        [
          "pinout",
          "assign-signal",
          "-p",
          "{{project}}",
          "--pin",
          "{{led_pin}}",
          "--signal",
          "GPIO"
        ],
        [
          "sw-config",
          "set-parameter-value",
          "-p",
          "{{project}}",
          "-r",
          "default_gpio_group_id",
          "--parameter-path",
          "pins/{{led_pin}}/basic/mode",
          "-v",
          "OUTPUT"
        ],
        [
          "peripherals",
          "enable",
          "-p",
          "{{project}}",
          "--peripheral",
          "{{uart}}",
          "--mode",
          "Async"
        ],
        [
          "pinout",
          "assign-signal",
          "-p",
          "{{project}}",
          "--pin",
          "{{tx_pin}}",
          "--signal",
          "{{uart}}_TX"
        ],
        [
          "pinout",
          "assign-signal",
          "-p",
          "{{project}}",
          "--pin",
          "{{rx_pin}}",
          "--signal",
          "{{uart}}_RX"
        ],
        [
          "sw-config",
          "set-multiple-parameters",
          "-p",
          "{{project}}",
          "-r",
          "{{uart}}",
          "--parameters",
          "[{\"path\":\"basic/baud_rate\",\"value\":\"115200\"},{\"path\":\"basic/parity\",\"value\":\"NONE\"}]"
        ],
        [
          "utilities",
          "enable-utility",
          "-p",
          "{{project}}",
          "-n",
          "Basic_stdio"
        ],
        [
          "sw-config",
          "set-parameter-value",
          "-p",
          "{{project}}",
          "-r",
          "Basic_stdio",
          "--parameter-path",
          "resourcesAllocation/uart_instance",
          "-v",
          "{{uart}}"
        ],
        [
          "composer",
          "add-component",
          "-p",
          "{{project}}",
          "-c",
          "STMicroelectronics.basic_stdio.2.1.0$STMicroelectronics::Utility:Basic stdio:Core@1.1.0#interface"
        ],
        [
          "composer",
          "add-component",
          "-p",
          "{{project}}",
          "-c",
          "STMicroelectronics.basic_stdio.2.1.0$STMicroelectronics::Utility:Basic stdio:itf_io&UART@1.1.0#STM32 HAL UART"
        ],
        [
          "clock",
          "get-clock-status",
          "-p",
          "{{project}}"
        ]
      ],
      "files": [
        {
          "source": "templates/hal2-led-uart.c",
          "destination": "main.c"
        }
      ],
      "required_outputs": [
        "CMakeLists.txt",
        "main.h",
        "main.c",
        "{{name}}.ioc2"
      ]
    },
