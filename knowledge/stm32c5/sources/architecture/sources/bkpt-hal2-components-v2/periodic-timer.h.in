#ifndef {{unit}}_H
#define {{unit}}_H
#include "stm32_hal.h"
#ifdef __cplusplus
extern "C" {
#endif
/* Generated init runs once after mx_system_init; failure is fail-stop.
 * Fixed nominal {{frequency_hz}} Hz under the pinned 144 MHz timer clock.
 * No dynamic clock changes, external clock, DMA or application sequencing.
 */
hal_status_t {{unit}}_init(void);
/* Owner-only main/thread calls. start(NULL) fails. Repeated start while active
 * fails. Each successful start begins a fresh full period; stop is idempotent.
 * Callback runs in this timer IRQ: keep bounded, no start/stop/reconfiguration
 * from callbacks. Its meaning and application counters belong to the caller.
 * No weak callback collision: this component installs a per-handle adapter.
 */
hal_status_t {{unit}}_start(void (*callback)(void));
hal_status_t {{unit}}_stop(void);
#ifdef __cplusplus
}
#endif
#endif
