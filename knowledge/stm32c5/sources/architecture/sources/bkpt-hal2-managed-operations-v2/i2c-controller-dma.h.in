#ifndef {{unit}}_H
#define {{unit}}_H
#include "stm32_hal.h"
#include "{{unit}}_operation.h"
#ifdef __cplusplus
extern "C" {
#endif
/* Use the generated header. bkpt_op_result has state, reason, buffers_released. States: READY, ACTIVE, STOPPING, DONE, FAILED, UNSAFE (prefix BKPT_OP_). Reasons: NO_ERROR, IO_ERROR, TIMEOUT, CANCELLED, START_ERROR (prefix BKPT_OP_). DONE permits the next start; FAILED/UNSAFE are terminal, no retry/rearm. buffers_released is true only READY/DONE/FAILED; never reuse on STOPPING/UNSAFE. */
/* Pass monotonically wrapping uint32 millisecond now and timeout/recovery in 1..INT32_MAX ms; call poll regularly from the sole foreground owner with interrupts unmasked. Deadlines are observed, not hard real time. Error wins over timeout; completion first observed at deadline is timeout. Proven quiescence at recovery deadline releases as FAILED, otherwise UNSAFE permanently retains buffers. No waiting inside poll/cancel. */
/* start returns 0 when ownership was accepted, including an underlying HAL-start failure reported by poll; nonzero refuses without new ownership. Check every start and poll. Owns all callbacks/handles/IRQs; no raw accessors or callback registration. ISR/masked-context calls are rejected or return the current snapshot without progress. Buffers stay live until buffers_released; application must check size, DMA accessibility and cache/MPU requirements. */
/* Already initialized after mx_system_init; preserve generated IRQ dispatch/build entries. {{unit}}_init returns the latched HAL status; failure is terminal. ISR/masked context instead returns HAL_BUSY without initialization. Header bkpt_components/{{unit}}.h. */
/* start_tx/rx serializes one transaction, fixed 7-bit address {{device_address_7bit}}, runtime bytes 1..{{length_bytes}} (profile maximum255). DONE means peripheral completion plus DMA quiescence. A failed low-level DMA start may retain its ISR pointer: bounded recovery ends UNSAFE, conservatively retaining buffers. */
/* Fixed nominal1MHz/144MHz PCLK1 timing, analog filter and checked HAL FMP I/O-drive enable on PB6/PB7 FT_f pads, plus controller BERR workaround. Pullups, supply/load, rise/fall/setup, device FM+ support and measured timing remain unverified; no current guarantee. HAL owns DMA callbacks; SRAM lifetime remains application contract. FAILED proves buffer release, not I2C bus/electrical recovery. Any failure is terminal, including NACK; device probing/EEPROM acknowledge polling needs a different profile. */
hal_status_t {{unit}}_init(void);
bkpt_op_result {{unit}}_poll(uint32_t now);
bkpt_op_result {{unit}}_cancel(uint32_t now);
int {{unit}}_start_tx(const void *buffer, uint32_t bytes, uint32_t now, uint32_t timeout, uint32_t recovery);
int {{unit}}_start_rx(void *buffer, uint32_t bytes, uint32_t now, uint32_t timeout, uint32_t recovery);
#ifdef __cplusplus
}
#endif
#endif
