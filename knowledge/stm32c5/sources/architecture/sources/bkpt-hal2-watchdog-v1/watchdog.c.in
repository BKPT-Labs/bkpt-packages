#include "{{unit}}.h"
static unsigned int attempted;
static volatile unsigned int started;
static hal_status_t status = HAL_ERROR;
static hal_iwdg_handle_t watchdog;
hal_status_t {{unit}}_init(void)
{
  if (attempted != 0U) { return status; }
  attempted = 1U;
  status = HAL_IWDG_Init(&watchdog, {{watchdog_instance}});
  return status;
}
hal_status_t {{unit}}_start(void)
{
  if (attempted == 0U || status != HAL_OK) { return HAL_ERROR; }
  if (__get_IPSR() != 0U || started != 0U) { return HAL_BUSY; }
  /* No window (minimum time 0) and no early interrupt (time 0). */
  const hal_status_t result = HAL_IWDG_Start(&watchdog, 0U, {{timeout_ms}}U, 0U);
  if (result != HAL_OK) { status = HAL_ERROR; return result; }
  started = 1U;
  return HAL_OK;
}
hal_status_t {{unit}}_refresh(void)
{
  if (attempted == 0U || status != HAL_OK || started == 0U) { return HAL_ERROR; }
  return HAL_IWDG_Refresh(&watchdog);
}
uint32_t {{unit}}_timeout_ms(void)
{
  if (attempted == 0U || status != HAL_OK || started == 0U) { return 0U; }
  return HAL_IWDG_GetMaxTime(&watchdog);
}
