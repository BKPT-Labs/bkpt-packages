#ifndef {{unit}}_H
#define {{unit}}_H
#include "stm32_hal.h"
#ifdef __cplusplus
extern "C" {
#endif
/* Period and high time of a digital signal on pad {{pad_name}}, measured by the
 * allocated timer channel on request. The whole timer belongs to this unit:
 * it counts microseconds, 1 MHz under the pinned 144 MHz timer clock, and
 * captures both edges of the input. Generated init runs once after
 * mx_system_init; failure is fail-stop. The pad is switched to the timer by
 * init with the selected pull ({{pull}}).
 */
hal_status_t {{unit}}_init(void);
/* Waits for a rising edge, the falling edge after it and the next rising
 * edge, then returns *period_us, rising edge to rising edge, and *high_us,
 * rising edge to falling edge, in whole microseconds of the timer clock.
 * Blocks until done or until timeout_ms milliseconds of the same clock have
 * passed, 1..60000: HAL_TIMEOUT. The capture register is polled, so two
 * edges closer together than the polling loop can follow are not measured
 * wrongly but reported as HAL_ERROR, by the timer's overcapture flag or by
 * an edge found already waiting. One thread only, never from an interrupt;
 * interrupts that hold the thread longer than the distance between two
 * edges cause the same HAL_ERROR. Outputs are written only with HAL_OK.
 */
hal_status_t {{unit}}_measure(uint32_t timeout_ms, uint32_t *period_us, uint32_t *high_us);
#ifdef __cplusplus
}
#endif
#endif
