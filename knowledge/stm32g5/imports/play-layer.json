  "cites": [
    {
      "id": "identity",
      "source": "dfp",
      "start": "<variant Dvariant=\"STM32G564RET3\">",
      "end": "STM32G5(5-6)4R(B-C-E)Tx(Z-_)_pinout.json",
      "statement": "DFP 2.0.0 declares variant STM32G564RET3 in an LQFP64 package and names the pinout descriptor STM32G5(5-6)4R(B-C-E)Tx(Z-_)_pinout.json for it."
    },
    {
      "id": "play-instance",
      "source": "device-header",
      "start": "#define PLAY1                          PLAY1_NS",
      "statement": "Device header defines PLAY1 as the non-secure PLAY instance outside the secure build."
    },
    {
      "id": "play-intro",
      "source": "play-c",
      "start": "The programmable logic array allows the user",
      "end": "by cascading logic elements.",
      "statement": "SDK describes PLAY as lookup tables programmed to any logical function, cascadable into more complex functions."
    },
    {
      "id": "play-usage-order",
      "source": "play-c",
      "start": "3. Configure the combinational and/or sequential logic functions in this order:",
      "end": "After this step, the PLAY Outputs can be connected to GPIOs or internal peripherals.",
      "statement": "SDK usage text: configure input multiplexers, then lookup tables, then output multiplexers; HAL_PLAY_Start locks the configuration and makes the kernel clock operational; only after it may PLAY outputs be connected to GPIOs. It also gives the truth table encoding."
    },
    {
      "id": "play-truth-formula",
      "source": "play-c",
      "start": "The truth table of a lookup table is composed of 16 combinations",
      "end": "for IN3, IN2, IN1 & IN0: 0x8000",
      "statement": "SDK documents the truth table: combination ID = IN0 + 2*IN1 + 4*IN2 + 8*IN3 and the value is the sum of O(y) * 2^y; AND of IN1 and IN0 is 0x8888."
    },
    {
      "id": "play-update",
      "source": "play-c",
      "start": "6. Update PLAY Configuration (optional):",
      "end": "Or disabling GPIO and disconnecting each peripheral taking the PLAY peripheral as inputs.",
      "statement": "SDK: to update lookup table configurations call HAL_PLAY_Stop first; it disables interrupts, clears flags and unlocks the configuration; outputs should be disconnected meanwhile to avoid glitches."
    },
    {
      "id": "play-config-table",
      "source": "play-c",
      "start": "USE_HAL_PLAY_CLK_ENABLE_MODEL     | HAL_CLK_ENABLE_NO",
      "statement": "SDK: by default HAL_PLAY_Init does not enable the PLAY clock (USE_HAL_PLAY_CLK_ENABLE_MODEL is HAL_CLK_ENABLE_NO)."
    },
    {
      "id": "play-write-timeout",
      "source": "play-c",
      "start": "@brief Maximum Timeout for any write on Software Trigger or Edge Trigger register.",
      "end": "#define PLAY_WRITE_TIMEOUT_MS (4000U)",
      "statement": "SDK: a software trigger or edge trigger write takes 3 cycles of the PLAY kernel clock plus 2 PCLK cycles; the SDK bounds it by 4000 ms."
    },
    {
      "id": "play-edge-write",
      "source": "play-c",
      "start": "static hal_status_t PLAY_LUT_SetEdgeTrigger(const hal_play_handle_t *hplay,",
      "nth": 1,
      "end": "^}$",
      "regex_end": true,
      "statement": "SDK defines the edge trigger write HAL_PLAY_Start ends with: HAL_BUSY when a write is pending, then it waits on the write-busy flag up to the given limit of HAL ticks."
    },
    {
      "id": "play-min-pulse-range",
      "source": "play-h",
      "start": "uint32_t                       min_pulse_width; /*!< Minimum Pulse Width. Value in range 0x00 to 0xFF */",
      "statement": "SDK: the input multiplexer minimum pulse width is a value from 0x00 to 0xFF."
    },
    {
      "id": "play-truth-helper",
      "source": "play-helpers",
      "start": "helper_play_truth_table_from_expr(expr, vars) {",
      "end": "return table;",
      "statement": "SDK code generator turns an expression of A, B, C, D into a truth table by setting bit i when the expression holds with A = bit 0, B = bit 1, C = bit 2, D = bit 3 of i."
    },
    {
      "id": "rcc-play-default",
      "source": "rcc-h",
      "start": "- PLAY: kernel clock is from LSE (default), LSI, PLL2P, HSE, HSI or HSI48.",
      "statement": "SDK: the PLAY kernel clock is LSE by default and can be LSI, PLL2P, HSE, HSI or HSI48."
    },
    {
      "id": "example-kernel-lsi",
      "source": "example-gate-xor-play",
      "start": "HAL_RCC_PLAY1_EnableClock();",
      "end": "if (HAL_RCC_PLAY1_SetKernelClkSource(HAL_RCC_PLAY1_CLK_SRC_LSI) != HAL_OK)",
      "statement": "ST gate_xor example for NUCLEO-G564RE enables the PLAY1 clock, initializes PLAY1 and selects LSI as its kernel clock."
    },
    {
      "id": "example-input-filter",
      "source": "example-gate-xor-play",
      "start": "in_config[0].source          = HAL_PLAY1_IN_IN4_MUX4;",
      "end": "in_config[0].min_pulse_width = 100;",
      "statement": "ST gate_xor example configures input multiplexer 4 on external input IN4 with edge detection bypassed and a minimum pulse width of 100."
    },
    {
      "id": "example-xor-table",
      "source": "example-gate-xor-play",
      "start": "lut_config[0].truth_table     = 0x6666; /* Logical expression: A ^ B */",
      "end": "lut_config[0].input_source[HAL_PLAY_LUT_INPUT3] = HAL_PLAY_LUT_INPUT_DEFAULT;",
      "statement": "ST gate_xor example writes 0x6666 for A ^ B with A on lookup table input 0, B on input 1 and the default source on inputs 2 and 3 that the table ignores."
    },
    {
      "id": "example-input-pad",
      "source": "example-gate-xor-play",
      "start": "PC13    ------>   PLAY1_IN4",
      "end": "HAL_GPIO_Init(HAL_GPIOC, HAL_GPIO_PIN_13, &gpio_config);",
      "statement": "ST gate_xor example sets PC13 (the user button input PLAY1_IN4) to alternate function 14, push-pull, pull-down, high speed."
    },
    {
      "id": "example-output-pad",
      "source": "example-gate-xor-play",
      "start": "PD11    ------>   PLAY1_OUT0",
      "end": "HAL_GPIO_Init(HAL_GPIOD, HAL_GPIO_PIN_11, &gpio_config);",
      "statement": "ST gate_xor example sets PD11 (PLAY1_OUT0) to alternate function 14, push-pull, no pull, high speed."
    },
    {
      "id": "example-lsi-enable",
      "source": "example-gate-xor-rcc",
      "start": "/* Resources using LSI (32 kHz):",
      "end": "if (HAL_RCC_PLAY1_SetKernelClkDivider(HAL_RCC_PLAY1_CLK_DIVIDER1) != HAL_OK)",
      "statement": "ST gate_xor example enables LSI (32 kHz) and sets the PLAY1 kernel clock divider to 1."
    },
    {
      "id": "example-filter-note",
      "source": "example-gate-xor-readme",
      "start": "As the PLAY input is configured to be filtered by setting a minimal pulse width",
      "statement": "ST gate_xor README: a filtered input is taken into account only if stable for a number of PLAY clock cycles set by the filter configuration."
    },
    {
      "id": "example-components",
      "source": "example-gate-xor-components",
      "start": "Cgroup:STM32 HAL#Csub:GPIO#Cversion:2.0.0\")",
      "nth": 0,
      "end": "Cgroup:STM32 LL#Csub:PLAY#Cversion:2.0.0\")",
      "statement": "ST gate_xor example lists the STM32 HAL GPIO and PLAY and STM32 LL GPIO and PLAY components among its CMSIS components."
    },
    {
