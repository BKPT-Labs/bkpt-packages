  "integration": {
    "id": "hal2.play-integration",
    "guidance": "Shared integration of every generated PLAY unit: switches on the SDK's PLAY and GPIO modules in the captured HAL configuration and adds the STM32 HAL and LL GPIO and PLAY components that the STM32CubeG5 PLAY examples list to the foundation's CMSIS component list, so the SDK's CMake builds stm32g5xx_hal_play.c and stm32g5xx_hal_gpio.c. No PLAY, clock or pad setup of its own; the units do that.",
    "evidence": [
      "policy-10",
      "sdk-USE_HAL_PLAY_MODULE",
      "sdk-USE_HAL_GPIO_MODULE",
      "example-components",
      "play-config-table"
    ],
    "edits": [
      {
        "path": "generated/hal/stm32g5xx_hal_conf.h",
        "mode": "replace",
        "old": "#define USE_HAL_PLAY_MODULE                     0U",
        "new": "#define USE_HAL_PLAY_MODULE                     1U"
      },
      {
        "path": "generated/hal/stm32g5xx_hal_conf.h",
        "mode": "replace",
        "old": "#define USE_HAL_GPIO_MODULE                     0U",
        "new": "#define USE_HAL_GPIO_MODULE                     1U"
      },
      {
        "path": "cmake/components.cmake",
        "mode": "insert_before",
        "old": "if(${CMAKE_BUILD_TYPE} STREQUAL \"debug_GCC_NUCLEO-G564RE\")",
        "new": "# BKPT PLAY units: STM32 HAL and LL GPIO and PLAY, as the STM32CubeG5 PLAY examples list them.\nlist(APPEND CMSIS_COMPONENTS_LIST \"Cvendor:STMicroelectronics#Cclass:Device#Cgroup:STM32 HAL#Csub:GPIO#Cversion:2.0.0\")\nlist(APPEND CMSIS_COMPONENTS_LIST \"Cvendor:STMicroelectronics#Cclass:Device#Cgroup:STM32 HAL#Csub:PLAY#Cversion:2.0.0\")\nlist(APPEND CMSIS_COMPONENTS_LIST \"Cvendor:STMicroelectronics#Cclass:Device#Cgroup:STM32 LL#Csub:GPIO#Cversion:2.0.0\")\nlist(APPEND CMSIS_COMPONENTS_LIST \"Cvendor:STMicroelectronics#Cclass:Device#Cgroup:STM32 LL#Csub:PLAY#Cversion:2.0.0\")\n"
      }
    ]
  },
