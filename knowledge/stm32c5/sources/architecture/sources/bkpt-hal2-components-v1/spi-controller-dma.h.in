#ifndef {{unit}}_H
#define {{unit}}_H
#include "stm32_hal.h"
#ifdef __cplusplus
extern "C" {
#endif
/* Called once after successful mx_system_init; later calls return its first result.
 * Initialization failure is fail-stop: do not start transfers or reuse partial state.
 * An active physical DMA channel fails with HAL_BUSY. Only each owned inactive
 * channel is deinitialized/reinitialized; no controller-wide reset or transfer.
 * No implicit wait, buffer allocation or application callback registration.
 */
hal_status_t {{unit}}_init(void);
hal_spi_handle_t *{{unit}}_handle(void);
/* Master full-duplex 8-bit mode 0, MSB, internal NSS, reviewed prescaler. Register SPI TxRx/error/abort callbacks; HAL owns DMA callbacks. DMA completion is not final SPI completion: EOT IRQ is installed. Application owns separate CS sequencing and SRAM buffers. Confirm SPI-level abort completion before reuse or release; count_packet equals bytes only for this 8-bit profile. */
#ifdef __cplusplus
}
#endif
#endif
