#include "{{unit}}.h"
static unsigned int attempted;
static hal_status_t status = HAL_ERROR;
static hal_crc_handle_t unit;
hal_status_t {{unit}}_init(void)
{
  if (attempted != 0U) { return status; }
  attempted = 1U;
  {{crc_clock}}();
  status = HAL_CRC_Init(&unit, {{crc_instance}});
  if (status != HAL_OK) { return status; }
  hal_crc_config_t config = {0};
  config.polynomial_coefficient = 0x04C11DB7U;
  config.polynomial_size = HAL_CRC_POLY_SIZE_32B;
  config.crc_init_value = 0xFFFFFFFFU;
  config.input_data_reverse_mode = HAL_CRC_INDATA_REVERSE_BYTE;
  config.output_data_reverse_mode = HAL_CRC_OUTDATA_REVERSE_BIT;
  status = HAL_CRC_SetConfig(&unit, &config);
  return status;
}
hal_status_t {{unit}}_compute(const void *data, uint32_t bytes, uint32_t *crc32)
{
  if (attempted == 0U || status != HAL_OK) { return HAL_ERROR; }
  if (data == NULL || crc32 == NULL || bytes == 0U) { return HAL_INVALID_PARAM; }
  if (__get_IPSR() != 0U || HAL_CRC_GetState(&unit) != HAL_CRC_STATE_IDLE) { return HAL_BUSY; }
  uint32_t value = 0U;
  /* Calculate starts from the configured initial value, Accumulate would continue. */
  const hal_status_t result = HAL_CRC_Calculate(&unit, data, bytes, &value);
  if (result != HAL_OK) { return result; }
  *crc32 = value ^ 0xFFFFFFFFU;
  return HAL_OK;
}
