#ifndef {{unit}}_H
#define {{unit}}_H
#include "stm32_hal.h"
#ifdef __cplusplus
extern "C" {
#endif
/* One single-ended analog input of {{converter_name}} on pad {{pad_name}}, read on
 * request. Generated init runs once after mx_system_init; failure is
 * fail-stop. The first unit on a converter brings it up: kernel clock HCLK
 * divided by 8 (18 MHz under the pinned 144 MHz profile), 12-bit resolution,
 * software trigger, one conversion per request, then activation and the
 * converter's own offset calibration. Every unit on the same converter shares
 * that one handle; the pad is switched to analog mode by its own unit.
 */
hal_status_t {{unit}}_init(void);
/* Converts this input once and waits for the result, at most a few
 * milliseconds. *counts is 0..4095, right aligned: the pad voltage as a
 * fraction of the reference voltage VREF+, in steps of 1/4096. It is not a
 * voltage: the reference is not measured, so volts follow only from a
 * reference the application knows. Sampling takes the longest setting, 288.5
 * cycles of the 18 MHz clock. When the previous read on this converter was
 * of another input, the converter is stopped, switched, started and
 * calibrated again first. One thread only, never from an interrupt, and
 * never while another unit of the same converter is reading. HAL_BUSY,
 * HAL_TIMEOUT or HAL_ERROR leave *counts untouched.
 */
hal_status_t {{unit}}_read(uint32_t *counts);
#ifdef __cplusplus
}
#endif
#endif
