    "source_derived_findings": [
      {
        "id": "SDK.RTYPE_byte_by_word_accepts_halfword_tail",
        "classification": "source_derived_defect_not_hardware_reproduced",
        "preconditions": [
          "Handle in HAL_CRC_STATE_IDLE, valid buffer/result pointers and otherwise admissible configuration.",
          "Input mode BYTE_BYWORD: RTYPE_IN=1 and REV_IN=2",
          "size_byte=2; arbitrary data bytes; no independent caller rejection",
          "BYTE_BYWORD can be selected through HAL_CRC_SetInputReverseMode; Init also leaves inherited register configuration unchanged."
        ],
        "trace": [
          "IS_CRC_DATA_SIZE_VALID checks REV_IN==2 first, admitting any positive even length before considering RTYPE_IN.",
          "Optional runtime parameter check validates pointers/nonzero only; debug assertion also admits size2.",
          "CRC_FeedData tail emits LL_CRC_FeedData16, a C store through a volatile uint16_t pointer. Compiler instruction selection is not verified.",
          "RM says this nonword write is ignored with RTYPE_IN=1. Both callers reach HAL_OK after feed."
        ],
        "inference": "Input omission follows from the documented register rule and this code path; actual device result and timing have not been observed.",
        "candidate_gate": "Independently require a multiple of four bytes for RTYPE_IN modes; no reliance on HAL_OK/debug/runtime parameter guard alone.",
        "evidence": [
