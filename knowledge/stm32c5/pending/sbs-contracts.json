    "contracts": [
      {
        "id": "hdpl",
        "detail": "HDPL progresses monotonically 1 to 2 to 3 and saturates at 3. Write recommended 0x6A, then independently read status before subsequent action. RM states every value other than 0xB4 can increment. Table81 layout suggests unknown encodings map to level3, but its layout is not visually confirmed and the neighboring secure-storage section is family-specific. Unknown codes are not admitted; treating them as restrictive is a policy, not proven status decoding. Reset/boot policy must be established before use.",
        "evidence": [
          "RM0522:p359",
          "RM0522:p360",
          "RM0522:p361",
          "RM0522:p362"
        ]
      },
      {
        "id": "compensation_readiness",
        "detail": "The single VDDIO cell requires HSI enabled. EN does not imply RDY. Use measured cell code only after RDY; CS selects live cell or software code. Reset selects software 0x78 (PMOS7/NMOS8) with cell disabled. Codes are finite bitfields, not qualified slew rates or electrical settings. Clock/pin/rail ownership and voltage limits remain open.",
        "evidence": [
          "RM0522:p358",
          "RM0522:p359",
          "RM0522:p365",
          "RM0522:p366",
          "RM0522:p367"
        ]
      },
      {
        "id": "ADC_shared_remap",
        "detail": "Bits 0..3 select ADC1 IN2 PA2/PC4, IN5 PA5/PC5, IN6 PA6/PB0, IN7 PA7/PB1. These are shared channel selectors, not independent simultaneous pins. Package and ADC candidate dependencies remain unchanged.",
        "evidence": [
          "RM0522:p363",
          "RM0522:p364",
          "HAL.remap"
        ]
      },
      {
        "id": "FPU_masks",
        "detail": "FPUIMR is privileged-only; reset enables five conditions and disables inexact. SBS has no dedicated IRQ; this is FPU interrupt masking and does not establish CPU/NVIC delivery or clear exception state.",
        "evidence": [
          "RM0522:p361",
          "RM0522:p364",
          "HAL.FPU_break"
        ]
      },
      {
        "id": "break_locks",
        "detail": "CFGR2 CLL/SEL/PVDL are set-only until system reset; PVDL also makes PVD enable/threshold read-only. ECCL is software-clearable despite its lock name. Exact recipient candidates are TIM1/8/15, not family TIM16/17. Per-timer break configuration, flags and reaction remain unqualified.",
        "evidence": [
          "RM0522:p367",
          "RM0522:p368",
          "HAL.FPU_break",
          "header.break",
          "RM0522:p361",
          "HAL.types"
        ]
      },
      {
        "id": "core_lock",
        "detail": "CLCKR privileged-only, unprivileged RAZ/WI. LOCKVTOR/LOCKMPU set-only until system reset. RM names MPU_CTRL/RNR/RBAR; full architecture MPU register coverage and actual writes taking effect require separate review. Do not lock as part of discovery.",
        "evidence": [
          "RM0522:p368",
          "LL.lock"
        ]
      },
      {
        "id": "NMI_policy",
        "detail": "ECCNMIR bit0=1 masks NMI for flash data-part double ECC errors; bit0=0 enables that path. It is privileged-only and does not establish instruction-fetch behavior or RAMCFG NMI policy.",
        "evidence": [
          "RM0522:p369",
          "LL.NMI"
        ]
      },
      {
        "id": "erase_status",
        "detail": "MESR bits0 MCLR and16 IPMEE are W1C and not affected by system reset. MCLR marks SRAM2 plus ICACHE erase completion; IPMEE marks ICACHE erase completion. After software clear, zero alone does not prove erase remains ongoing. Preserve status evidence and ownership before clearing.",
        "evidence": [
          "RM0522:p365",
          "LL.flags"
        ]
      },
      {
        "id": "clock_reset",
        "detail": "Exact header/API identify APB3 clock and reset bit1, while RM358 says AHB configuration port. Peripheral reset API exists but does not by itself establish scope over temporal isolation, system-reset-only locks or retained MESR. Do not assume reset reverses every protection state. RM358 also mentions debug-configuration reset controlled in DBGMCU; its exact scope remains unresolved.",
        "evidence": [
          "RM0522:p358",
          "header.clock",
          "header.reset",
          "HAL.clock_note",
          "RCC.reset",
          "RM0522:p357"
        ]
      }
    ],
    "source_derived_SDK_gates": [
      {
        "id": "MESR_RMW_W1C",
        "detail": "LL ClearFlag_IPMEE, ClearFlag_MCLR and ClearFlag use STM32_SET_BIT, a read-modify-write. If both flags read as one, clearing either writes both ones and clears both under RM W1C semantics. Read and preserve all pending evidence; generic HAL/LL clear does not isolate selected flag. Source-derived conditional effect, not hardware observation.",
        "evidence": [
          "LL.flags",
          "family.macros",
          "RM0522:p365",
          "HAL.clear"
        ]
      },
      {
        "id": "HDPL_no_readback",
        "detail": "HAL SetHDPLevelValue accepts only adjacent 1->2 or 2->3, returns error for same-level or skipping, and returns HAL_OK immediately after increment write without the required post-write status check. Serialize monotonic transition and read status independently before continuing. Unknown status codes cannot satisfy either branch and return HAL_ERROR. The read-then-write sequence is not atomic against another transition owner.",
        "evidence": [
          "HAL.hdpl",
          "LL.hdpl",
          "RM0522:p360",
          "HAL.types"
        ]
      },
      {
        "id": "compensation_timeout",
        "detail": "EnableCompensationCell sets EN then polls RDY using an iteration budget 50*(SystemCoreClock/1000)+1, not a measured 50ms deadline. It does not enable/check HSI, ensure the SBS clock, or undo EN on HAL_ERROR. HAL_OK reports RDY, not CS source selection or electrical suitability.",
        "evidence": [
          "HAL.compensation",
          "HAL.guards",
          "RM0522:p359"
        ]
      },
      {
        "id": "compensation_setters",
        "detail": "Code-source setter does not check RDY before selecting cell. Value getters do not check RDY. Software PMOS/NMOS codes have only debug range checks; unmasked LL writes can spill outside their 4-bit fields. GetConfig output pointers are debug-asserted only. Establish valid pointers, cell mask=1, code range0..15, clock and readiness separately.",
        "evidence": [
          "HAL.compensation",
          "LL.compensation",
          "RM0522:p366"
        ]
      },
      {
        "id": "lock_and_remap_readback",
        "detail": "Break/CPU-lock/remap functions generally write without ownership or readback; debug assertions do not enforce privilege, lock state or ADC inactivity. DisableBreak only asserts ECCL but release calls can attempt clearing set-only fields without success feedback. Shared configuration updates require serialized owners. Unprivileged CLCKR writes are ignored and its reads return zero, so the getter can appear unlocked. That RAZ/WI behavior is not generalized to FPUIMR/ECCNMIR.",
        "evidence": [
          "HAL.FPU_break",
          "HAL.lock",
          "HAL.remap",
          "LL.break",
          "LL.lock",
          "RM0522:p368"
        ]
      }
    ],
    "conflicts": [
      {
        "id": "HDPL_reset_prose",
        "detail": "RM358 describes counter0..3 resetting to zero only software reset/POR; RM359..362 specify1..3, system reset and reset code0x51. Preserve discrepancy rather than admitting level0.",
        "evidence": [
          "RM0522:p358",
          "RM0522:p359",
          "RM0522:p360",
          "RM0522:p362"
        ]
      },
      {
        "id": "PMCR_reserved_reset",
        "detail": "RM363 declares PMCR reset0x80000000 while bit31 reserved; Table83 reset rendering shows zero listed fields and exact header only ADC bits0..3. Preserve upper reserved state, do not invent writable bit31.",
        "evidence": [
          "RM0522:p363",
