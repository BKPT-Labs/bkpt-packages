#ifndef {{unit}}_H
#define {{unit}}_H
#include "stm32_hal.h"
#ifdef __cplusplus
extern "C" {
#endif
/* CRC-32 of a buffer of bytes on the {{crc_name}} unit: polynomial 0x04C11DB7,
 * initial value 0xFFFFFFFF, every input byte and the result bit-reversed, the
 * result inverted. This is the CRC-32 of ISO 3309 and zlib; its value for the
 * nine ASCII characters "123456789" is 0xCBF43926. The whole unit belongs to
 * this component. Generated init runs once after mx_system_init; failure is
 * fail-stop.
 */
hal_status_t {{unit}}_init(void);
/* Computes the CRC-32 of bytes bytes at data, from the initial value, in one
 * call, and writes it to *crc32. Nothing is carried from one call to the
 * next. bytes is 1 or more. One thread only, never from an interrupt.
 * *crc32 is written only with HAL_OK.
 */
hal_status_t {{unit}}_compute(const void *data, uint32_t bytes, uint32_t *crc32);
#ifdef __cplusplus
}
#endif
#endif
