    "constraints": [
      {
        "id": "access_width",
        "detail": "DR admits right-aligned 8/16/32-bit accesses only when RTYPE_IN=0. With RTYPE_IN=1 nonword writes are ignored. Other registers require 32-bit accesses. RM p473 explicitly names RTYPE_IN and ignored nonword accesses; p475 uses ambiguous RTYPE wording and states word-only access.",
        "evidence": [
          "RM0522:p472",
          "RM0522:p473",
          "RM0522:p475"
        ]
      },
      {
        "id": "polynomial",
        "detail": "Polynomial widths 7/8/16/32; coefficients must be odd and fit the selected width. Do not change POL/value size during computation without first resetting or reading DR. SetConfig writes POL, POLYSIZE, INIT then reverse modes. Completion/read/reset must already be established before POL writes; a prior successful calculation ends with a DR read, but this does not cover unrelated or concurrent register actors.",
        "evidence": [
          "RM0522:p474",
          "HAL.polynomial_validation",
          "HAL.config",
          "HAL.polynomial_config"
        ]
      },
      {
        "id": "stateful_reset_and_init",
        "detail": "DR writes feed computation; CR.RESET loads INIT and self-clears. Writing INIT initializes DR. Calculate resets before feeding; Accumulate preserves existing state. SetConfig/SetConfigPolynomial change computation state. IDR is unaffected by CR.RESET. HAL Init initializes the handle without resetting CRC registers; inherited hardware configuration persists. DeInit resets configuration and clears IDR through software register writes, affecting any other handle, without RCC peripheral reset.",
        "evidence": [
          "RM0522:p473",
          "RM0522:p474",
          "RM0522:p477",
          "HAL.calculate_accumulate",
          "HAL.config",
          "HAL.polynomial_config",
          "LL.init",
          "HAL.init_deinit",
          "HAL.reset_internal",
          "HAL.reset_config"
        ]
      },
      {
        "id": "ownership",
        "detail": "Maintain exclusive physical-instance ownership through configuration and entire accumulation sequence. Per-handle state guard is conditional on USE_HAL_CHECK_PROCESS_STATE; otherwise state assignment only. Even enabled it does not exclude another handle or LL/register actor. Configuration setters do not acquire it. Setters use debug state assertions; nondebug builds do not enforce those assertions. SetConfig output-reversal/poly-size compatibility is debug-only, whereas SetConfigPolynomial and SetOutputReverseMode also check it when USE_HAL_CHECK_PARAM=1.",
        "evidence": [
          "HAL.handle_guard",
          "HAL.config",
          "HAL.polynomial_config",
          "HAL.calculate_accumulate",
          "HAL.assert_fallback",
          "HAL.output_mode"
        ]
      },
      {
        "id": "reversal_context",
        "detail": "RTYPE and REV fields jointly determine reversal; the SVD enum descriptions alone omit that dependence. Preserve mode, polynomial width, byte sequence, feed width and output interpretation as owned state.",
        "evidence": [
          "RM0522:p474",
          "RM0522:p476",
          "HAL.validation",
          "HAL.feed"
        ]
      }
