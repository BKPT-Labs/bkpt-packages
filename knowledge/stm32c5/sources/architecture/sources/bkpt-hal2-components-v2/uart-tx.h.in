#ifndef {{unit}}_H
#define {{unit}}_H
#include "stm32_hal.h"
#ifdef __cplusplus
extern "C" {
#endif
/* Called once after successful mx_system_init; later calls return its first result.
 * Initialization failure is fail-stop: do not start transfers or reuse partial state.
 * An active physical DMA channel fails with HAL_BUSY. Only each owned inactive
 * channel is deinitialized/reinitialized; no controller-wide reset or transfer.
 * No implicit wait, buffer allocation or application callback registration.
 */
hal_status_t {{unit}}_init(void);
hal_uart_handle_t *{{unit}}_handle(void);
/* Adopts foundation UART. TX DMA only. UART IRQ provides final TX completion; TX/error/abort callbacks take the handle. Register per-handle UART callbacks before any transfer while BOTH TX/RX idle; return does not validate state. HAL owns linked DMA callbacks. Keep SRAM buffers valid until completion or confirmed UART-level abort. Do not share active TX with basic_stdio. */

/* Owner-only blocking abort: HAL_OK proves owned DMA software IDLE, physical
 * IDLE=1/EN=0, UART TX/RX idle and both DMA request gates off. Already-idle DMA
 * is accepted from those observations, not from HAL_DMA_Abort's return value.
 * Call only in main/thread context with interrupts unmasked and a live SysTick;
 * no concurrent start/reconfiguration, no ISR callbacks restarting this UART.
 * HAL_BUSY is NOT confirmation. Any non-OK result requires fail-stop: retain
 * buffers, do not start another transfer, including through a cached handle.
 * A hardware abort failure masks only
 * owned IRQs and invalidates the accessor. No whole-controller reset is used.
 * After success discard old application completion/error flags before rearm.
 * Does not prove a full frame reached the wire or recover an external protocol.
 */
hal_status_t {{unit}}_abort_confirmed(void);
#ifdef __cplusplus
}
#endif
#endif
