    "contracts": [
      {
        "id": "map_not_admission",
        "detail": "Twenty named word positions0x00..0x4C agree with the exact header structure. Table165 reserved rows cover word offsets0x50..0x68. A map position does not override channel2/dual-register availability conflict in stable DAC survey, prove arbitrary access widths, or authorize writes. Preserve existing package/PA5 and internal-routing gates.",
        "evidence": [
          "RM0522:p673",
          "RM0522:p709",
          "RM0522:p710",
          "header.struct"
        ]
      },
      {
        "id": "reset_scope",
        "detail": "The map shows zero in defined reset fields except factory-dependent OTRIM bits in CCR and THOLD/TREFRESH reset1 per channel (SHHR/SHRR0x00010001). Reserved blank cells are not separate writable reset fields. CCR0x00XX00XX is a register reset notation; do not assign deterministic trim values or write reserved bits.",
        "evidence": [
          "RM0522:p704",
          "RM0522:p707",
          "RM0522:p708",
          "RM0522:p709",
          "RM0522:p710"
        ]
      },
      {
        "id": "shared_register_owner",
        "detail": "Both channels share CR,SWTRGR,SR,CCR,MCR,SHHR,SHRR and packed dual-data registers. Channel-scoped changes require preserving other channel fields and correct side-effect semantics. SR mixes hardware status with W1C DMA underrun flags; generic read-modify-write can retire unrelated pending underrun evidence. Raw map is not a safe generic register-update contract.",
        "evidence": [
          "RM0522:p703",
          "RM0522:p704",
          "RM0522:p709",
          "RM0522:p710"
        ]
      },
      {
        "id": "HFSEL_map_agreement",
        "detail": "Table165, detailed RM705/706 and exact header agree HFSEL[2:0] at bits15:13, with12:10 reserved. An initial visual column-count error was rejected during independent review. Stable HAL frequency-boundary and encoding gates remain unchanged.",
        "evidence": [
          "RM0522:p710",
          "RM0522:p705",
          "RM0522:p706",
          "header.HFSEL"
        ]
      }
    ],
    "conflicts": [
      {
        "id": "map_WAVE2_width",
        "detail": "Rendered Table165 labels WAVE2[2:0] inside bits23:22, while detailed RM694 and exact header declare two-bit WAVE2[1:0]. Preserve label defect; no third WAVE bit inferred. Channel2 availability remains separately unresolved.",
        "evidence": [
