#include "{{unit}}.h"
static unsigned int attempted;
/* Read by set_duty, which may run in an interrupt that preempts start or stop. */
static volatile unsigned int running;
static hal_status_t status = HAL_ERROR;
static hal_tim_handle_t timer;
static const uint32_t prescaler = {{prescaler}}U;
static const uint32_t period = {{period}}U;
static uint32_t compare_for(uint32_t duty_permille)
{
  return (uint32_t)(((uint64_t)(period + 1U) * duty_permille) / 1000U);
}
static int clock_and_registers_match(void)
{
  return HAL_RCC_TIM_GetKernelClkFreq({{peripheral_symbol}}) == 144000000U &&
         LL_TIM_GetPrescaler({{peripheral_symbol}}) == prescaler &&
         LL_TIM_GetAutoReload({{peripheral_symbol}}) == period &&
         (uint64_t){{frequency_hz}}U * (prescaler + 1U) * (period + 1U) == 144000000ULL;
}
hal_status_t {{unit}}_init(void)
{
  if (attempted != 0U) { return status; }
  attempted = 1U;
  const uint32_t frequency = {{frequency_hz}}U;
  const uint32_t kernel = HAL_RCC_TIM_GetKernelClkFreq({{peripheral_symbol}});
  if (kernel != 144000000U || frequency == 0U || kernel % frequency != 0U) { return status; }
  if (prescaler > 65534U || period < 999U || period > 65534U ||
      (uint64_t)frequency * (prescaler + 1U) * (period + 1U) != kernel) { return status; }
  {{timer_clock}}();
  if (LL_TIM_IsEnabledCounter({{peripheral_symbol}}) != 0U) { status = HAL_BUSY; return status; }
  {{timer_reset}}();
  status = HAL_TIM_Init(&timer, {{timer_instance}});
  if (status != HAL_OK) { return status; }
  hal_tim_config_t config = {0};
  config.prescaler = prescaler;
  config.period = period;
  config.repetition_counter = 0U;
  config.counter_mode = HAL_TIM_COUNTER_UP;
  config.clock_sel.clock_source = HAL_TIM_CLK_INTERNAL;
  status = HAL_TIM_SetConfig(&timer, &config);
  if (status != HAL_OK) { return status; }
  hal_tim_oc_compare_unit_config_t compare = {0};
  compare.mode = HAL_TIM_OC_PWM1;
  compare.pulse = 0U;
  status = HAL_TIM_OC_SetConfigCompareUnit(&timer, {{compare_unit}}, &compare);
  if (status != HAL_OK) { return status; }
  /* With preload a new compare value is taken at an update event, so a duty
   * change never cuts a period short. */
  status = HAL_TIM_OC_EnableComparePreload(&timer, {{compare_unit}});
  if (status != HAL_OK) { return status; }
  hal_tim_oc_channel_config_t output = {0};
  output.polarity = HAL_TIM_OC_HIGH;
  output.idle_state = HAL_TIM_OC_IDLE_STATE_RESET;
  output.override_state = HAL_TIM_OC_OVERRIDE_RESET;
  output.break_mode = HAL_TIM_OC_BREAKMODE_IMMEDIATE;
  status = HAL_TIM_OC_SetConfigChannel(&timer, {{channel}}, &output);
  if (status != HAL_OK) { return status; }
  if (!clock_and_registers_match()) { status = HAL_ERROR; return status; }
  {{pad_clock}}();
  hal_gpio_config_t gpio = {0};
  gpio.mode = HAL_GPIO_MODE_ALTERNATE;
  gpio.output_type = HAL_GPIO_OUTPUT_PUSHPULL;
  gpio.pull = HAL_GPIO_PULL_NO;
  gpio.speed = HAL_GPIO_SPEED_FREQ_LOW;
  gpio.alternate = {{pad_alternate}};
  status = HAL_GPIO_Init({{pad_port}}, {{pad_pin}}, &gpio);
  return status;
}
hal_status_t {{unit}}_start(uint32_t duty_permille)
{
  if (attempted == 0U || status != HAL_OK) { return HAL_ERROR; }
  if (duty_permille > 1000U) { return HAL_INVALID_PARAM; }
  if (__get_IPSR() != 0U || running != 0U || HAL_TIM_GetState(&timer) != HAL_TIM_STATE_IDLE ||
      LL_TIM_IsEnabledCounter({{peripheral_symbol}}) != 0U) { return HAL_BUSY; }
  if (!clock_and_registers_match()) { return HAL_ERROR; }
  hal_status_t result = HAL_TIM_OC_SetCompareUnitPulse(&timer, {{compare_unit}}, compare_for(duty_permille));
  if (result != HAL_OK) { status = HAL_ERROR; return result; }
  /* UG reloads the prescaler, takes the preloaded compare value and
   * restarts the counter. The counter is enabled before the output: an
   * output enabled first would hold the pad active until counting begins,
   * for as long as an interrupt delays it. This order can only shorten the
   * first period at the pad. */
  LL_TIM_GenerateEvent_UPDATE({{peripheral_symbol}});
  LL_TIM_ClearFlag_UPDATE({{peripheral_symbol}});
  result = HAL_TIM_Start(&timer);
  if (result != HAL_OK) { status = HAL_ERROR; return result; }
  result = HAL_TIM_OC_StartChannel(&timer, {{channel}});
  if (result != HAL_OK) { (void)HAL_TIM_Stop(&timer); status = HAL_ERROR; return result; }
  running = 1U;
  return HAL_OK;
}
hal_status_t {{unit}}_set_duty(uint32_t duty_permille)
{
  if (attempted == 0U || status != HAL_OK || running == 0U) { return HAL_ERROR; }
  if (duty_permille > 1000U) { return HAL_INVALID_PARAM; }
  return HAL_TIM_OC_SetCompareUnitPulse(&timer, {{compare_unit}}, compare_for(duty_permille));
}
hal_status_t {{unit}}_stop(void)
{
  if (attempted == 0U || status != HAL_OK) { return HAL_ERROR; }
  if (__get_IPSR() != 0U) { return HAL_BUSY; }
  if (running == 0U) { return HAL_OK; }
  /* From here on set_duty fails, also from an interrupt that preempts this call. */
  running = 0U;
  hal_status_t result = HAL_TIM_OC_StopChannel(&timer, {{channel}});
  if (result != HAL_OK) { status = HAL_ERROR; return result; }
  result = HAL_TIM_Stop(&timer);
  if (result != HAL_OK) { status = HAL_ERROR; return result; }
  if (LL_TIM_IsEnabledCounter({{peripheral_symbol}}) != 0U) { status = HAL_ERROR; return status; }
  return HAL_OK;
}
