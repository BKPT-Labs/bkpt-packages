#ifndef {{unit}}_H
#define {{unit}}_H
#include "stm32_hal.h"
#ifdef __cplusplus
extern "C" {
#endif
/* Period and high time of a digital signal on pad {{pad_name}}, measured by the
 * allocated timer channel on request. The whole timer belongs to this unit:
 * it counts microseconds, 1 MHz under the pinned 144 MHz timer clock, over a
 * 16-bit period, captures both edges of the input, and uses the compare flag
 * of the other of its first two channels as a half-turn mark; that channel
 * drives no pad. Generated init runs once after mx_system_init; failure is
 * fail-stop. The pad is switched to the timer by init with the selected pull
 * ({{pull}}).
 */
hal_status_t {{unit}}_init(void);
/* Waits for the first rising edge the channel captures, the falling edge
 * after it and the next rising edge, then writes *period_us, rising edge to
 * rising edge, and *high_us, rising edge to falling edge, in whole
 * microseconds of the timer clock. timeout_ms, 1..60000, is counted on the
 * same clock from the start of the counter, and an edge at or after the
 * limit is not used. The call blocks and polls the timer. A caller that is
 * delayed returns later by that delay, also past the limit.
 *
 * How the count is followed: the counter has 16 bits and the hardware sets
 * two marks in every turn, 32768 counts apart. In each pass of its loop the
 * unit reads the count and the status, acknowledges the marks it saw and
 * reads the marks again, as one step with interrupts masked for those three
 * or four register accesses; the caller's mask is put back. It ends the
 * measurement with HAL_ERROR when both marks are set at once, when a mark is
 * set behind an acknowledgement, on the timer's overcapture flag, and when
 * a further edge arrives while one is being read. A delay of 65.536 ms or
 * more from one pass to the next sets both marks.
 *
 * What a result means, provided that nothing else writes this timer and that
 * the timer and the pad behave as the reference manual describes: HAL_OK
 * comes with the period and high time of those three edges, all of them
 * before the limit, wherever and for however long the caller was delayed.
 * HAL_TIMEOUT means that the three edges did not all occur before the
 * limit. A delay the unit cannot resolve ends in HAL_ERROR and not in a
 * value.
 *
 * When it completes without HAL_ERROR: when the caller is not delayed for
 * 32 ms or longer between two passes, and each edge is read before the next
 * one arrives, which takes a few microseconds plus any delay in between.
 *
 * One thread only, never from an interrupt. Outputs are written only with
 * HAL_OK.
 */
hal_status_t {{unit}}_measure(uint32_t timeout_ms, uint32_t *period_us, uint32_t *high_us);
#ifdef __cplusplus
}
#endif
#endif
